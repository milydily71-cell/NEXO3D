<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexo_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:background="@color/nexo_panel">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEXO  /  STUDIO 3D"
            android:textColor="@color/nexo_text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/import_button"
            style="@style/NexoEditorButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Import Model" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/viewport_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/nexo_bg" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:horizontalScrollBarEnabled="false"
        android:background="@color/nexo_panel">
        <LinearLayout
            android:id="@+id/editor_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView
        android:id="@+id/editor_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/nexo_text_muted"
        android:textSize="12sp"
        android:background="@color/nexo_panel" />
</LinearLayout>
